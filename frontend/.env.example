# ── Frontend environment (Vite) ──────────────────────────────────────────────
# Values are baked into the build, so never put secrets here.

# Leave EMPTY when the backend serves the frontend (single-service deploy, see
# DEPLOYMENT.md) or when the Vite dev server proxies to the backend locally.
# Set it ONLY if the frontend is hosted on a different domain than the API,
# e.g. https://aura-api.up.railway.app
VITE_API_URL=

# Optional — enables "Continue with Google". Must match GOOGLE_CLIENT_ID on the backend.
VITE_GOOGLE_CLIENT_ID=

# Dev only: where `npm run dev` forwards API calls (backend PORT).
VITE_DEV_API_TARGET=http://localhost:3002
