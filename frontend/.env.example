# ============================================================
# Aura Design AI — Frontend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Backend API URL ───────────────────────────────────────────
# Dev: leave EMPTY — Vite proxies /auth /chat etc. to localhost:3002 automatically
# Prod: set to your deployed backend URL (Railway/Render)
#       e.g. https://aura-backend-production.up.railway.app
VITE_API_URL=

# ── Google OAuth (optional) ───────────────────────────────────
# Only needed if you enabled Google Sign-In
# Must match the GOOGLE_CLIENT_ID set in your backend .env
# VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
