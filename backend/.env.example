# ============================================================
# Aura Design AI — Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Server ────────────────────────────────────────────────────
PORT=3002
NODE_ENV=development   # change to 'production' on Railway/Render

# ── Supabase (required) ───────────────────────────────────────
# Get from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...your_service_role_key
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ── Auth ──────────────────────────────────────────────────────
# Use a strong random string (min 32 chars), e.g.: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-this

# ── AI / LLM (required) ───────────────────────────────────────
# Groq — free at https://console.groq.com (14,400 req/day on free tier)
GROQ_API_KEY=gsk_...your_groq_key

# Gemini — free at https://aistudio.google.com (used for embeddings + fallback)
GEMINI_API_KEY=AIza...your_gemini_key

# ── Vector Search (optional) ──────────────────────────────────
# Pinecone — free tier at https://www.pinecone.io
# Leave blank to use Supabase fallback for benchmark search
PINECONE_API_KEY=pcsk_...your_pinecone_key
PINECONE_INDEX_BENCHMARKS=aura-benchmarks

# ── Google OAuth (optional) ───────────────────────────────────
# Only needed if you want Google Sign-In
# Get from: https://console.cloud.google.com → APIs → Credentials → OAuth 2.0
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# ── CORS ──────────────────────────────────────────────────────
# Your frontend URL(s) — comma-separated for multiple
# Dev: http://localhost:5174  |  Prod: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5174

# ── Backend public URL (for screenshot absolute URLs) ─────────
# Dev: leave empty — auto-detected as http://localhost:PORT
# Prod: your Railway backend URL e.g. https://aura-backend.up.railway.app
BACKEND_URL=

# ── LangSmith (optional — for tracing) ───────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_...your_langsmith_key
LANGCHAIN_PROJECT=aura-design-ai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
