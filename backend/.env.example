# ─────────────────────────────────────────────────────────────────────────────
# Aura Design AI — backend environment
# Copy to backend/.env for local dev. In production set these in your host's
# "Variables"/"Environment" settings instead (Railway, Render, Fly…).
# ─────────────────────────────────────────────────────────────────────────────

PORT=3002
NODE_ENV=development            # production on the server

# ── Supabase (required) ──────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key   # Settings → API → service_role (keep secret!)

# Optional direct Postgres connection (faster). Use the "Session pooler" or
# "Transaction pooler" string from Settings → Database. If it can't connect,
# the backend falls back to the Supabase HTTPS API automatically.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DB_DRIVER=auto                  # auto | pg | rest

# ── Auth (required) ──────────────────────────────────────────────────────────
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string

# lax  → frontend served by this backend (recommended) or proxied on the same domain
# none → frontend on a different domain (requires HTTPS; Safari may still block it)
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true            # defaults to true when NODE_ENV=production

# Comma-separated browser origins allowed to call the API from another domain.
# Not needed for the single-service deploy.
FRONTEND_URL=http://localhost:5174

# Public URL of this backend. Optional — only used to build absolute links.
BACKEND_URL=

# ── AI (required for chat / insights / recommendations) ─────────────────────
GROQ_API_KEY=gsk_your_groq_key
# Current Groq models (Nov 2026). Groq retires models often — if one is shut
# down the backend automatically falls back to GROQ_FALLBACK_MODELS.
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_JSON_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# ── Optional: semantic benchmark search ──────────────────────────────────────
GEMINI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_BENCHMARKS=aura-benchmarks

# ── Optional: Google sign-in (also set VITE_GOOGLE_CLIENT_ID in the frontend) ─
GOOGLE_CLIENT_ID=

# ── File storage for screenshots & uploads ──────────────────────────────────
# supabase → Supabase Storage bucket (default in production; survives redeploys)
# local    → ./uploads on disk (dev only; wiped when a container restarts)
STORAGE_DRIVER=local
SUPABASE_STORAGE_BUCKET=aura-uploads

# ── Scraper ──────────────────────────────────────────────────────────────────
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium   # set automatically in Docker
MAX_CONCURRENT_SCRAPES=2
